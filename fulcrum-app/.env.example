# FULCRUM is BYO-key and local-first: your Anthropic API key is stored only in
# your browser (IndexedDB) and used to call Claude directly. Nothing is sent to
# any FULCRUM server — there is no FULCRUM server. You can also paste the key in
# Settings inside the app instead of using this file.
#
# Optional: pre-seed a key for local dev only (never commit a real key).
VITE_ANTHROPIC_API_KEY=
