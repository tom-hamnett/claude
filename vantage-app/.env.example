# ── BYO-key mode (client-side) ───────────────────────────────────────────────
# Optional: pre-seed an Anthropic key for local dev only (never commit a real key).
# In the app, users normally enter keys in Settings instead.
VITE_ANTHROPIC_API_KEY=

# ── Managed mode (server-side, set these in Vercel → Project → Settings → Env) ─
# The managed proxy (api/*) holds the provider keys so users only need a VANTAGE key.
GEMINI_API_KEY=            # video (Gemini Pro)
ANTHROPIC_API_KEY=         # evaluation + coach (Claude)
DEEPGRAM_API_KEY=          # audio transcription

# Per-account quota granted on first use of a VANTAGE key (override as needed):
VANTAGE_PLAN_VIDEO_MIN=60
VANTAGE_PLAN_AUDIO_MIN=600
VANTAGE_GEMINI_MODEL=gemini-2.5-pro

# Vercel KV (quota store) and Blob (large-media upload) are auto-injected when you
# link those stores to the project:  KV_REST_API_URL / KV_REST_API_TOKEN,
# BLOB_READ_WRITE_TOKEN.
# Set VANTAGE_DEV_OPEN=true to bypass licence checks while testing locally.
VANTAGE_DEV_OPEN=
