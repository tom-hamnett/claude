// APEX - DAX measures
// Create on the Fact_Spend_Agg table: Home > New measure, paste one at a time.

// format string: \$#,0,,\bn;-\$#,0,,\bn;\$#,0,,\bn
Total Spend = SUM ( Fact_Spend_Agg[spend] )

// format string: \$#,0,,\bn;-\$#,0,,\bn;\$#,0,,\bn
Addressable Spend = CALCULATE ( [Total Spend], Fact_Spend_Agg[addressability] = "Addressable" )

// format string: \$#,0,,\bn;-\$#,0,,\bn;\$#,0,,\bn
Directly Addressable Spend = CALCULATE ( [Total Spend], Fact_Spend_Agg[addressability] = "Addressable", Fact_Spend_Agg[lifecycle_stage] <> "BUILD" )

// format string: \$#,0,,\bn;-\$#,0,,\bn;\$#,0,,\bn
IHG Addressable Spend = CALCULATE ( [Addressable Spend], Fact_Spend_Agg[ihg_flag] = "IHG" )

// format string: 0.0%;-0.0%;0.0%
IHG Share of Addressable % = DIVIDE ( [IHG Addressable Spend], [Addressable Spend] )

// format string: #,0
Hotel Count = SUM ( Fact_Spend_Agg[hotels] )

// format string: \$#,0,,\m;-\$#,0,,\m;\$#,0,,\m
Programme Spend = CALCULATE ( SUM ( Fact_Programme_Spend[spend] ), Fact_Programme_Spend[measure] = "Programme (P2P) Spend" )

// format string: \$#,0,,\m;-\$#,0,,\m;\$#,0,,\m
CRF Total = SUM ( Fact_CRF[crf_usd] )

// format string: 0.00%;-0.00%;0.00%
Capture Rate % = DIVIDE ( [Programme Spend], [Directly Addressable Spend] )

// format string: 0.00%;-0.00%;0.00%
Average CRF Rate % = DIVIDE ( [CRF Total], [Programme Spend] )

