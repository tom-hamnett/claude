{
  "name": "APEX Dashboard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install",
  "postStartCommand": "npm run build && npm start &",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": {
      "label": "APEX Dashboard",
      "onAutoForward": "openBrowser"
    }
  }
}
