# Streamlit Cloud Secrets
# Copy these to your Streamlit Cloud app settings at:
# https://share.streamlit.io > Your app > Settings > Secrets
#
# DO NOT commit the real secrets.toml to git.

ANTHROPIC_API_KEY = "sk-ant-..."
GOOGLE_API_KEY = "..."
APP_PASSWORD = "your-password-here"

# Optional: Turso cloud database (recommended for persistent data)
# TURSO_DATABASE_URL = "libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN = "..."

# Optional: HeyGen avatar provider
# HEYGEN_API_KEY = "..."
# AVATAR_PROVIDER = "heygen"
