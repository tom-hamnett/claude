# =============================================================================
# FLUX environment
# Copy to .env.local for local dev, or set these in your host (Vercel/Netlify).
#
# WITHOUT these two vars, FLUX runs in LOCAL mode (data in the browser only).
# WITH them, FLUX runs in CLOUD mode: email sign-in + shared team workspace.
# =============================================================================

# From Supabase: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Note: the AI provider key is NOT set here. Each user enters their own AI key
# in the app's Settings (stored on their device, never in the cloud).
