# =============================================================================
# GTM Intelligence Engine — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env
# =============================================================================

# --- AI Providers (only two keys needed) ---
ANTHROPIC_API_KEY=sk-ant-...          # Powers: master assets, strategy, discovery, scripts, emails
GOOGLE_API_KEY=...                    # Powers: social copy, SEO, images (Imagen), video (Veo), voice (TTS)

# Optional — only needed if you specifically want GPT-4o for something
# OPENAI_API_KEY=sk-...

# --- Avatar Provider (BYOK) ---
# Default: 'none' (use B-roll + voiceover only).
# Options: none | heygen | d-id (future) | synthesia (future) | hedra (future)
AVATAR_PROVIDER=none
# Only needed if AVATAR_PROVIDER=heygen — get yours at https://app.heygen.com
HEYGEN_API_KEY=

# --- Database ---
# Local dev uses SQLite (no config needed). Set these for production Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# --- Deployment Channels ---
# Reddit (via PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=gtm-engine/0.1

# LinkedIn
LINKEDIN_ACCESS_TOKEN=

# X / Twitter (via Tweepy)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Engine Config ---
STAGE_GATE_INTERVAL_DAYS=7
DEFAULT_AI_MODEL=claude-sonnet-4-20250514
LOG_LEVEL=INFO
